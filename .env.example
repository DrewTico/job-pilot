# Copy to .env and fill in. The .env file is gitignored — never commit real keys.

# Required for real (non-demo) runs. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional task-specific models (these are the normal defaults).
# JOB_AGENT_SCORING_MODEL=claude-sonnet-5
# JOB_AGENT_TAILORING_MODEL=claude-sonnet-5
# JOB_AGENT_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
# Legacy fallback for task settings without an explicit override.
# JOB_AGENT_MODEL=claude-haiku-4-5
