# Copy to .env and fill in. The .env file is gitignored — never commit real keys.

# Required for real (non-demo) runs. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional task-specific models (these are the normal defaults).
# JOB_AGENT_SCORING_MODEL=claude-sonnet-5-5
# JOB_AGENT_TAILORING_MODEL=claude-sonnet-5-5
# JOB_AGENT_CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
# JOB_AGENT_WRITING_MODEL=claude-sonnet-5-5
# Legacy fallback for task settings without an explicit override.
# JOB_AGENT_MODEL=claude-sonnet-5-5

# JOB_AGENT_MONTHLY_BUDGET_USD=40.00
# JOB_AGENT_SCORE_THRESHOLD=65
# JOB_AGENT_MAX_PACKETS_PER_DAY=8

# JOB_AGENT_IMMEDIATE_SCORING_MAX_AGE_HOURS=48
# JOB_AGENT_MAX_BATCH_ITEMS=100

# Required only for approval-queue --access tailscale; local mode needs neither.
# Put real values only in the private, gitignored .env, never in a service unit.
# Exact authorized Tailscale user login and canonical Serve hostname (no URL/port).
# These are placeholders, not usable credentials or a real tailnet hostname.
# JOB_AGENT_APPROVAL_TAILSCALE_LOGIN=<authorized-user-login>
# JOB_AGENT_APPROVAL_TAILSCALE_HOST=<device>.<tailnet>.ts.net
